# Dedicated projection maintenance process. This identity may SET ROLE accounting_system
# and must not be shared with the API or the ordinary unified worker.
ACCOUNTING_ENV=production
ACCOUNTING_SERVICE_ROLE=maintenance
ACCOUNTING_MAINTENANCE_DATABASE_URL=postgresql://accounting_maintenance.PROJECT_REF:REPLACE_PASSWORD@YOUR_SESSION_POOLER:5432/postgres?sslmode=require
ACCOUNTING_PROJECTION_POLL_SECONDS=5
