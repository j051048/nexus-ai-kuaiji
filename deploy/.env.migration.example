# Copy to a private *.local file, or fill only this service's variables in Zeabur.
# Never commit filled values; do not configure ACCOUNTING_ADMIN_DATABASE_URL.
ACCOUNTING_ENV=production
ACCOUNTING_SEED=0
ACCOUNTING_QUEUE_EMBEDDED_WORKER=0
ACCOUNTING_STORAGE_BACKEND=supabase
ACCOUNTING_STORAGE_SUPABASE_URL=https://PROJECT_REF.supabase.co
ACCOUNTING_STORAGE_BUCKET=accounting-originals
ACCOUNTING_STORAGE_SERVER_KEY=sb_secret_REPLACE_ME
ACCOUNTING_STORAGE_TIMEOUT_SECONDS=20
ACCOUNTING_STORAGE_ALLOW_HTTP=false
ACCOUNTING_SERVICE_ROLE=migration
ACCOUNTING_WORKER_DATABASE_URL=postgresql://accounting_migration.PROJECT_REF:REPLACE_PASSWORD@YOUR_SESSION_POOLER:5432/postgres?sslmode=require
ACCOUNTING_MIGRATION_CONCURRENCY=1
# Deterministic legacy migration: no model keys, API DSN or Auth key.
