# Copy to a private *.local file, or fill only this service's variables in Zeabur.
# Never commit filled values; do not configure ACCOUNTING_ADMIN_DATABASE_URL.
ACCOUNTING_ENV=production
ACCOUNTING_SEED=0
ACCOUNTING_QUEUE_EMBEDDED_WORKER=0
ACCOUNTING_STORAGE_BACKEND=supabase
ACCOUNTING_STORAGE_SUPABASE_URL=https://PROJECT_REF.supabase.co
ACCOUNTING_STORAGE_BUCKET=accounting-originals
ACCOUNTING_STORAGE_SERVER_KEY=sb_secret_REPLACE_ME
ACCOUNTING_STORAGE_TIMEOUT_SECONDS=20
ACCOUNTING_STORAGE_ALLOW_HTTP=false
ACCOUNTING_SERVICE_ROLE=assistant
ACCOUNTING_WORKER_DATABASE_URL=postgresql://accounting_assistant.PROJECT_REF:REPLACE_PASSWORD@YOUR_SESSION_POOLER:5432/postgres?sslmode=require
# No ACCOUNTING_DATABASE_URL or admin DSN is allowed here.

# Two providers example: A for OCR; B for journal and chat.
# Use the SAME scene settings and tariffs on API, worker and assistant.
# BASE_URL/API_KEY must be paired; IDs are supplied by your chosen provider.
ACCOUNTING_AI_OCR_BASE_URL=https://PROVIDER_A.example/v1
ACCOUNTING_AI_OCR_API_KEY=REPLACE_ME
ACCOUNTING_AI_OCR_MODEL=REPLACE_VISION_MODEL_ID
ACCOUNTING_AI_JOURNAL_BASE_URL=https://PROVIDER_B.example/v1
ACCOUNTING_AI_JOURNAL_API_KEY=REPLACE_ME
ACCOUNTING_AI_JOURNAL_MODEL=REPLACE_JOURNAL_MODEL_ID
ACCOUNTING_AI_CHAT_BASE_URL=https://PROVIDER_B.example/v1
ACCOUNTING_AI_CHAT_API_KEY=REPLACE_ME
ACCOUNTING_AI_CHAT_MODEL=REPLACE_CHAT_MODEL_ID
ACCOUNTING_AI_RESPONSE_FORMAT=json_schema
ACCOUNTING_AI_TIMEOUT_SECONDS=45
ACCOUNTING_AI_MAX_CONCURRENCY=2
ACCOUNTING_AI_ALLOW_HTTP=0
# Fill actual CNY tariffs per million tokens; unknown prices stay blank.
ACCOUNTING_AI_OCR_INPUT_CNY_PER_MILLION=
ACCOUNTING_AI_OCR_OUTPUT_CNY_PER_MILLION=
ACCOUNTING_AI_PROPOSAL_INPUT_CNY_PER_MILLION=
ACCOUNTING_AI_PROPOSAL_OUTPUT_CNY_PER_MILLION=
ACCOUNTING_AI_CHAT_INPUT_CNY_PER_MILLION=
ACCOUNTING_AI_CHAT_OUTPUT_CNY_PER_MILLION=

# 每进程有界连接池；所有服务/副本的 MAX 合计需符合数据库容量
ACCOUNTING_DB_POOL_MIN=0
ACCOUNTING_DB_POOL_MAX=4
ACCOUNTING_DB_POOL_TIMEOUT_SECONDS=5
ACCOUNTING_DB_POOL_MAX_WAITING=32

# Requested fleet ceiling; actual ceiling is capped by the administrator-managed DB policy (1-8).
# Default remains 2. See docs/CONCURRENCY_STAGE17.md before raising capacity.
ACCOUNTING_PROCESSING_GLOBAL_LIMIT=2

# Stage 19 optional independent OCR. Keep these settings identical across API/workers.
# The Paddle service has no database keys; TOKEN matches its PADDLEOCR_API_TOKEN.
# OCR text is still extracted into fields by the ACCOUNTING_AI_OCR_* model.
# Start in vision mode; switch only after the private OCR service is ready.
ACCOUNTING_OCR_ENGINE=vision
ACCOUNTING_PADDLEOCR_URL=
ACCOUNTING_PADDLEOCR_TOKEN=
ACCOUNTING_PADDLEOCR_MODEL=PP-OCRv6_small_det+PP-OCRv6_small_rec@px3.7.2-pd3.3.1-det2048-line0-doc0-unwarp0-r1
ACCOUNTING_PADDLEOCR_MIN_SCORE=0.85
ACCOUNTING_PADDLEOCR_ALLOW_HTTP=0
ACCOUNTING_PADDLEOCR_ALLOWED_HOST=
