# Copy to .env.demo.local (Git ignored), never commit filled values.
# This aggregate file is only for local Docker Compose interpolation.
# In Zeabur inject the one matching restricted DSN per service, not all four.
ACCOUNTING_DATABASE_URL=postgresql://accounting_api.PROJECT_REF:REPLACE_PASSWORD@YOUR_SESSION_POOLER:5432/postgres?sslmode=require
ACCOUNTING_OCR_WORKER_DATABASE_URL=postgresql://accounting_ocr.PROJECT_REF:REPLACE_PASSWORD@YOUR_SESSION_POOLER:5432/postgres?sslmode=require
ACCOUNTING_ASSISTANT_WORKER_DATABASE_URL=postgresql://accounting_assistant.PROJECT_REF:REPLACE_PASSWORD@YOUR_SESSION_POOLER:5432/postgres?sslmode=require
ACCOUNTING_MIGRATION_WORKER_DATABASE_URL=postgresql://accounting_migration.PROJECT_REF:REPLACE_PASSWORD@YOUR_SESSION_POOLER:5432/postgres?sslmode=require
ACCOUNTING_SUPABASE_URL=https://PROJECT_REF.supabase.co
ACCOUNTING_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
ACCOUNTING_STORAGE_SUPABASE_URL=https://PROJECT_REF.supabase.co
ACCOUNTING_STORAGE_BUCKET=accounting-originals
ACCOUNTING_STORAGE_SERVER_KEY=sb_secret_REPLACE_ME
ACCOUNTING_STORAGE_TIMEOUT_SECONDS=20
# Local Compose maps API on loopback only. Public cloud hosts belong here too.
ACCOUNTING_ALLOWED_HOSTS=127.0.0.1,localhost,YOUR_API_DOMAIN.zeabur.app
ACCOUNTING_ALLOWED_ORIGINS=https://YOUR_FRONTEND.vercel.app

# Either one compatible provider for all scenes, or the paired overrides below.
ACCOUNTING_AI_BASE_URL=
ACCOUNTING_AI_API_KEY=
ACCOUNTING_AI_VISION_MODEL=
ACCOUNTING_AI_JOURNAL_MODEL=
ACCOUNTING_AI_CHAT_MODEL=
ACCOUNTING_AI_RESPONSE_FORMAT=json_schema
ACCOUNTING_AI_TIMEOUT_SECONDS=45
# Example two providers: supplier A OCR, supplier B journal and chat.
# Fill each scene's BASE_URL + API_KEY together. Never put keys in VITE_*.
ACCOUNTING_AI_OCR_BASE_URL=
ACCOUNTING_AI_OCR_API_KEY=
ACCOUNTING_AI_OCR_MODEL=
ACCOUNTING_AI_JOURNAL_BASE_URL=
ACCOUNTING_AI_JOURNAL_API_KEY=
ACCOUNTING_AI_CHAT_BASE_URL=
ACCOUNTING_AI_CHAT_API_KEY=
# Unknown tariffs stay blank, never assume calls are free.
ACCOUNTING_AI_OCR_INPUT_CNY_PER_MILLION=
ACCOUNTING_AI_OCR_OUTPUT_CNY_PER_MILLION=
ACCOUNTING_AI_PROPOSAL_INPUT_CNY_PER_MILLION=
ACCOUNTING_AI_PROPOSAL_OUTPUT_CNY_PER_MILLION=
ACCOUNTING_AI_CHAT_INPUT_CNY_PER_MILLION=
ACCOUNTING_AI_CHAT_OUTPUT_CNY_PER_MILLION=

# Requested fleet ceiling; actual ceiling is capped by the administrator-managed DB policy (1-8).
# Default remains 2. See docs/CONCURRENCY_STAGE17.md before raising capacity.
ACCOUNTING_PROCESSING_GLOBAL_LIMIT=2
