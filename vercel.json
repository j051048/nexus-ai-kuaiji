{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "api_gateway": {
      "root": "services/api_gateway",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "functions": {
        "main.py": {
          "maxDuration": 120
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api", "destination": { "service": "api_gateway" } },
    { "source": "/api/(.*)", "destination": { "service": "api_gateway" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
