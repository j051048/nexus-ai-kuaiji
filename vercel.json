{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "devCommand": "npm run dev -- --port $PORT",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/workspace/:path*", "destination": "/index.html" },
        { "source": "/admin", "destination": "/index.html" },
        { "source": "/admin/:path*", "destination": "/index.html" },
        { "source": "/account-activation", "destination": "/index.html" },
        { "source": "/account-recovery", "destination": "/index.html" }
      ]
    },
    "api_gateway": {
      "root": "services/api_gateway",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "functions": {
        "main.py": {
          "maxDuration": 120,
          "regions": ["icn1"]
        }
      }
    }
  },
  "routes": [
    { "src": "^/api(?:/.*)?$", "destination": { "service": "api_gateway" } },
    { "src": "^/(.*)$", "destination": { "service": "app" } }
  ]
}
