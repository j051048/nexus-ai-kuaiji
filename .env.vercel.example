# Vercel project: frontend + API gateway only; no accounting DB/model secrets.
# Server-side external backend origin. This is NOT a Vercel service binding.
ACCOUNTING_BACKEND_ORIGIN=https://your-accounting-backend.example
ACCOUNTING_GATEWAY_TIMEOUT_SECONDS=110
ACCOUNTING_GATEWAY_ALLOW_LOCAL_HTTP=0
# Local `vercel dev -L` only: explicitly set the origin to localhost and
# ALLOW_LOCAL_HTTP=1 in that terminal. Do not enable local HTTP in production.
