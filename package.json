{
  "name": "nexus-ai-accounting",
  "private": true,
  "version": "0.19.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:vercel-build": "node --test scripts/vercel_upload.test.mjs",
    "test:e2e:gate": "node --test scripts/e2e_gate.test.mjs scripts/e2e_harness.test.mjs",
    "test:e2e:core:dev": "node scripts/run_e2e.mjs --mode dev",
    "test:e2e:core:preview": "node scripts/run_e2e.mjs --mode preview",
    "test:e2e:core": "node scripts/run_e2e.mjs --mode both",
    "test:e2e:smoke": "playwright test e2e/stage20-home-loading.spec.ts e2e/batch1-navigation.spec.ts e2e/stage9-reconciliation.spec.ts e2e/invoice-imports.spec.ts e2e/monthly-batch.spec.ts e2e/firm-operations.spec.ts",
    "test:backend": "python -m pytest nexus_backend/tests -q",
    "env:doctor": "python scripts/env_doctor.py",
    "lint": "eslint src",
    "format": "prettier --write src package.json eslint.config.js vite.config.ts vitest.config.ts playwright*.ts tsconfig*.json scripts/e2e* scripts/run_e2e.mjs scripts/vercel_upload.test.mjs",
    "format:check": "prettier --check src package.json eslint.config.js vite.config.ts vitest.config.ts playwright*.ts tsconfig*.json scripts/e2e* scripts/run_e2e.mjs scripts/vercel_upload.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.91.1",
    "lucide-react": "0.462.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.58.2",
    "@types/node": "22.19.13",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react-swc": "3.11.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "7.3.6",
    "vitest": "4.1.0"
  }
}
