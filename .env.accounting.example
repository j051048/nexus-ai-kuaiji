# Only load this new file explicitly; never reuse the legacy .env snapshot.
# Copy to .env.accounting (Git ignored), fill values for your NEW project.
ACCOUNTING_ENV=development
ACCOUNTING_AUTH_MODE=supabase
ACCOUNTING_DATABASE_URL=postgresql://accounting_runtime.PROJECT_REF:REPLACE_PASSWORD@YOUR_SESSION_POOLER:5432/postgres?sslmode=require
ACCOUNTING_SUPABASE_URL=https://PROJECT_REF.supabase.co
ACCOUNTING_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Admin account provisioning only; keep this key on the API server, never VITE_*.
# Empty disables new-account activation links but leaves existing logins usable.
ACCOUNTING_SUPABASE_ADMIN_KEY=
ACCOUNTING_PUBLIC_APP_URL=https://YOUR_FRONTEND_DOMAIN
ACCOUNTING_ALLOW_FIRM_SIGNUP=0
ACCOUNTING_ALLOWED_HOSTS=127.0.0.1,localhost
ACCOUNTING_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
ACCOUNTING_SEED=0
ACCOUNTING_ATTACHMENT_ROOT=/data/accounting-private-attachments
ACCOUNTING_STORAGE_BACKEND=local
# Zeabur separate services cannot share a local volume. For cloud Demo use
# backend=supabase, remove ATTACHMENT_ROOT and fill the server-only fields below.
ACCOUNTING_STORAGE_SUPABASE_URL=
ACCOUNTING_STORAGE_BUCKET=
ACCOUNTING_STORAGE_SERVER_KEY=
ACCOUNTING_STORAGE_TIMEOUT_SECONDS=20
ACCOUNTING_STORAGE_ALLOW_HTTP=false
# Use an absolute private directory on a durable backend volume. Windows local
# trials may use C:/.../accounting-private-attachments. Back up it with the DB.
# For deployment change ACCOUNTING_ENV to production, configure real hosts and
# HTTPS origins. Run migrations separately with administrator credentials.

# Optional stage 4 provider. Keep keys on the backend; no VITE_ AI keys.
# Set explicit supplier IDs; there is no automatic fallback or external request
# until an authorized company administrator enables processing for that company.
ACCOUNTING_AI_BASE_URL=
ACCOUNTING_AI_API_KEY=
ACCOUNTING_AI_VISION_MODEL=
ACCOUNTING_AI_JOURNAL_MODEL=
ACCOUNTING_AI_RESPONSE_FORMAT=json_schema
ACCOUNTING_AI_TIMEOUT_SECONDS=45
ACCOUNTING_AI_MAX_CONCURRENCY=2
ACCOUNTING_AI_ALLOW_HTTP=0
# Independent scene overrides (optional); changing endpoint/key requires both.
# Keep identical scene settings on API/OCR worker/assistant worker.
ACCOUNTING_AI_OCR_BASE_URL=
ACCOUNTING_AI_OCR_API_KEY=
ACCOUNTING_AI_OCR_MODEL=
ACCOUNTING_AI_JOURNAL_BASE_URL=
ACCOUNTING_AI_JOURNAL_API_KEY=
ACCOUNTING_AI_CHAT_BASE_URL=
ACCOUNTING_AI_CHAT_API_KEY=
ACCOUNTING_AI_OCR_RESPONSE_FORMAT=
ACCOUNTING_AI_JOURNAL_RESPONSE_FORMAT=
ACCOUNTING_AI_CHAT_RESPONSE_FORMAT=
# BASE_URL example: https://your-provider.example/v1 (not /chat/completions).
# Use json_object only if your configured supplier explicitly requires it.
# Local HTTP is limited to localhost/127.0.0.1/[::1] with ALLOW_HTTP=1.

# Stage 5 durable queue. PostgreSQL deployments use a separate worker process
# and a separately provisioned, restricted worker login, never a DB admin key.
# Both API and worker must point to the SAME accounting database and private
# storage backend/bucket (or shared volume on ONE host). Do not expose this DSN
# to the frontend. This local config aggregates both logins; Zeabur containers
# use the separate deploy/.env.*.example files, only their matching DSN.
ACCOUNTING_QUEUE_EMBEDDED_WORKER=0
# 外部数据接入在代码层封禁；不要新增环境变量绕过，启用须走代码评审。
ACCOUNTING_WORKER_DATABASE_URL=postgresql://accounting_worker_runtime.PROJECT_REF:REPLACE_PASSWORD@YOUR_SESSION_POOLER:5432/postgres?sslmode=require
ACCOUNTING_QUEUE_CONCURRENCY=2
ACCOUNTING_QUEUE_POLL_SECONDS=1
ACCOUNTING_QUEUE_LEASE_SECONDS=180
# Stage 13 runs a separate deterministic legacy migration worker. It shares
# the private originals backend and restricted worker DSN, not the OCR slots.
# Start with PYTHONPATH=nexus_backend and python -m app.legacy_migration.worker
# --env-file .env.accounting. One active task per company; bounded global 1–2.
ACCOUNTING_MIGRATION_CONCURRENCY=1
# Local SQLite demo may enable the embedded worker with value 1; PostgreSQL
# requires the dedicated worker connection and process described in STAGE5_API.

# Stage 6 explicit CNY pricing per 1,000,000 tokens, at most 6 decimals.
# Leave unknown rates blank. These are configured estimates, not provider bills.
# No built-in price, currency conversion or online price lookup is performed.
ACCOUNTING_AI_OCR_INPUT_CNY_PER_MILLION=
ACCOUNTING_AI_OCR_OUTPUT_CNY_PER_MILLION=
ACCOUNTING_AI_PROPOSAL_INPUT_CNY_PER_MILLION=
ACCOUNTING_AI_PROPOSAL_OUTPUT_CNY_PER_MILLION=
# Set matching rates on BOTH API and dedicated worker. Company monthly quotas
# and request reserves are persisted and managed in the operations workbench.

# Stage 15 persistent company-scoped accounting dialogue. No fallback model.
ACCOUNTING_AI_CHAT_MODEL=
ACCOUNTING_AI_CHAT_INPUT_CNY_PER_MILLION=
ACCOUNTING_AI_CHAT_OUTPUT_CNY_PER_MILLION=
# Dedicated worker: python scripts/run_accounting_assistant.py --env-file .env.accounting
# It shares the existing database worker principal; network work is globally
# capped with OCR/proposal queue work. Chat request reserve is set per company
# in the operations budget dialog; zero pauses chat when quota is enabled.

# Stage 19 optional independent OCR. Keep these settings identical across API/workers.
# The Paddle service has no database keys; TOKEN matches its PADDLEOCR_API_TOKEN.
# OCR text is still extracted into fields by the ACCOUNTING_AI_OCR_* model.
# Start in vision mode; switch only after the private OCR service is ready.
ACCOUNTING_OCR_ENGINE=vision
ACCOUNTING_PADDLEOCR_URL=
ACCOUNTING_PADDLEOCR_TOKEN=
ACCOUNTING_PADDLEOCR_MODEL=PP-OCRv6_small_det+PP-OCRv6_small_rec@px3.7.2-pd3.3.1-det2048-line0-doc0-unwarp0-r1
ACCOUNTING_PADDLEOCR_MIN_SCORE=0.85
ACCOUNTING_PADDLEOCR_ALLOW_HTTP=0
ACCOUNTING_PADDLEOCR_ALLOWED_HOST=
